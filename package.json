{
  "name": "conversight",
  "version": "2.0.0",
  "private": true,
  "rnpm": {
    "assets": [
      "./Assets/fonts/"
    ]
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:release": "react-native run-android --variant=release",
    "android:build:staging": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/build/intermediates/res/merged/release/ && cd android && ./gradlew assembleRelease && cd ..",
    "android:build:production": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/build/intermediates/res/merged/release/ && cd android && ./gradlew assembleRelease && cd ..",
    "android:build:clean": "rm -rf android/app/src/main/res/drawable-* && rm -rf android/app/src/main/res/raw && rm -rf android/app/build/generated/res/react/release/drawable-* && rm -rf android/app/build/generated/res/react/release/raw",
    "start": "react-native start",
    "test": "jest --coverage",
    "package-license-report": "license-checker --csv --out package_licenses.csv",
    "lint": "eslint .",
    "type-check": "tsc"
  },
  "dependencies": {
    "@miblanchard/react-native-slider": "^2.1.0",
    "@react-native-async-storage/async-storage": "^1.17.10",
    "@react-native-community/netinfo": "^9.3.6",
    "@react-native-firebase/app": "^16.4.0",
    "@react-native-firebase/messaging": "^16.4.0",
    "@react-native-picker/picker": "^2.4.8",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^6.4.0",
    "@react-navigation/drawer": "^6.5.0",
    "@react-navigation/native": "^6.0.13",
    "@react-navigation/stack": "^6.3.3",
    "@reduxjs/toolkit": "^1.8.6",
    "date-fns": "^2.29.3",
    "i18next": "^22.0.5",
    "json-rules-engine": "^6.1.2",
    "license-checker": "^25.0.1",
    "moment": "^2.29.4",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-hook-form": "^7.39.1",
    "react-i18next": "^12.0.0",
    "react-native": "^0.70.6",
    "react-native-animated-pulse": "^1.0.1",
    "react-native-device-info": "^10.3.0",
    "react-native-gesture-handler": "^2.8.0",
    "react-native-get-random-values": "^1.8.0",
    "react-native-image-crop-picker": "^0.38.1",
    "react-native-quick-base64": "^2.0.5",
    "react-native-reanimated": "^2.12.0",
    "react-native-safe-area-context": "^4.4.1",
    "react-native-screens": "^3.18.2",
    "react-native-spinkit": "^1.5.1",
    "react-native-svg": "^13.6.0",
    "react-native-svg-transformer": "^1.0.0",
    "react-native-table-component": "^1.2.2",
    "react-native-track-player": "^3.2.0",
    "react-native-ui-lib": "^6.23.1",
    "react-native-vector-icons": "^9.2.0",
    "react-redux": "^8.0.2",
    "redux": "^4.2.0",
    "redux-persist": "^6.0.0",
    "uuid": "^9.0.0",
    "victory-brush-container": "^36.6.8",
    "victory-native": "^36.6.8"
  },
  "devDependencies": {
    "@babel/core": "7.19.6",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.19.0",
    "@babel/preset-env": "^7.19.4",
    "@babel/runtime": "^7.19.4",
    "@react-native-community/eslint-config": "^3.2.0",
    "@tsconfig/react-native": "^2.0.2",
    "@types/fbemitter": "^2.0.32",
    "@types/jest": "^27.4.1",
    "@types/lodash": "^4.14.186",
    "@types/numeral": "^2.0.2",
    "@types/react": "^18.0.23",
    "@types/react-native": "^0.70.6",
    "@types/react-native-table-component": "^1.2.4",
    "@types/react-native-vector-icons": "^6.4.12",
    "@types/react-redux": "^7.1.24",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "babel-jest": "^26.6.3",
    "babel-plugin-module-resolver": "^4.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^7.32.0",
    "eslint-import-resolver-babel-module": "^5.3.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jest": "^24.3.5",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": "^8.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "0.72.3",
    "prettier": "^2.8.1",
    "react-test-renderer": "^18.2.0",
    "typescript": "^4.8.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./jest.setup.js"
    ],
    "timers": "fake",
    "testEnvironment": "jsdom",
    "transformIgnorePatterns": [
      "/node_modules/(?!@react-native|react-native)"
    ]
  },
  "collectCoverageFrom": [
    "src/components/**/*.tsx",
    "src/components/**/*.js"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 1,
      "functions": 1,
      "lines": 1,
      "statements": 1
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run package-license-report && license-checker --onlyAllow 'BSD;MIT;Apache-2.0;ISC' && npm test"
    }
  }
}
